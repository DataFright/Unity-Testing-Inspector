# Unity-generated (only relevant if this folder is ever opened directly as a Unity project;
# normally it's referenced as a local package from a consuming project's own Library/)
/Library/
/Temp/
/Obj/
/obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/MemoryCaptures/
*.tmp

# IDE / generated project files
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# OS
.DS_Store
Thumbs.db

# CI~ is a real (if minimal) Unity project shell for CI (see its own README.md) - Unity/the test
# run will generate the usual per-machine/per-run junk in it the same as any other project.
/CI~/Library/
/CI~/Temp/
/CI~/Logs/
/CI~/UserSettings/
/CI~/obj/
/CI~/Build/
/CI~/Builds/
/CI~/EditMode-results.xml

# Internal-only working docs (AI-agent instructions, cross-session handoff notes, internal history
# files split out of the public tracker docs) - not meant for the public package/repo. Ignoring the
# file AND its paired .meta together, same as any other file fully excluded from the repo - this is
# NOT a blanket "ignore all .meta files" rule, see the note in docs/DESIGN.md / README.md about why
# real asset .meta files must stay tracked.
/CLAUDE.md
/CLAUDE.md.meta
/CLAUDE_HISTORY.md
/CLAUDE_HISTORY.md.meta
/docs/HANDOFF.md
/docs/HANDOFF.md.meta
/TESTS/TestTracker_HISTORY.md
/TESTS/TestTracker_HISTORY.md.meta
